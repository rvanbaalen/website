---
import BaseLayout from "./BaseLayout.astro";
import Prose from "../components/Prose.astro";
import { softwareSourceCodeSchema, breadcrumbSchema, normalizePath } from "../lib/seo";

interface Props {
  frontmatter: {
    name: string;
    description: string;
    repo: string;
    version?: string;
    tech?: string[];
    website?: string;
  };
}

const { name, description, repo, version, tech, website } = Astro.props.frontmatter;

const pagePath = normalizePath(Astro.url.pathname);
const pageUrl = new URL(pagePath, Astro.site).href;
const jsonLd = [
  softwareSourceCodeSchema({ name, description, repo, tech, version, url: pageUrl }),
  breadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "Open Source", path: "/open-source" },
    { name, path: pagePath },
  ]),
];
---

<BaseLayout title={`${name} — Robin van Baalen`} description={description} jsonLd={jsonLd}>
  <article>
    <header class="mb-10">
      <a
        href="/open-source"
        class="mb-6 inline-flex items-center gap-1.5 font-sans text-[14px] text-muted transition-colors duration-150 hover:text-accent"
      >
        <i class="ph ph-arrow-left text-[13px]" aria-hidden="true" />
        All open source
      </a>
      <h1 class="mb-3 text-3xl font-normal leading-tight tracking-tight text-primary md:text-4xl">
        {name}
      </h1>
      <p class="mb-4 text-lg text-muted">{description}</p>
      <div class="flex flex-wrap items-center gap-3 font-sans text-[13px] text-dim">
        {version && (
          <span class="rounded bg-accent-subtle px-2.5 py-0.5 font-medium text-accent-bright">
            v{version}
          </span>
        )}
        {tech && tech.map((t) => (
          <span class="rounded bg-surface px-2.5 py-0.5 text-muted">
            {t}
          </span>
        ))}
        {website && (
          <a
            href={website}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1 text-accent transition-colors duration-150 hover:text-accent-bright"
          >
            <i class="ph ph-globe text-sm" aria-hidden="true" />
            Website
          </a>
        )}
        <a
          href={`https://github.com/${repo}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 text-accent transition-colors duration-150 hover:text-accent-bright"
        >
          <i class="ph ph-github-logo text-sm" aria-hidden="true" />
          Source
        </a>
      </div>
    </header>
    <Prose>
      <slot />
    </Prose>
  </article>
</BaseLayout>
