---
import BaseLayout from "./BaseLayout.astro";
import Prose from "../components/Prose.astro";

interface Props {
  title: string;
  description: string;
  date: Date;
  tags: string[];
}

const { title, description, date, tags } = Astro.props;

const formattedDate = date.toLocaleDateString("en-US", {
  month: "long",
  day: "numeric",
  year: "numeric",
});
---

<BaseLayout title={`${title} — Robin van Baalen`} description={description}>
  <article>
    <header class="mb-10">
      <a
        href="/writing"
        class="mb-6 inline-flex items-center gap-1.5 font-sans text-[14px] text-muted transition-colors duration-150 hover:text-accent"
      >
        <i class="ph ph-arrow-left text-[13px]" aria-hidden="true" />
        All writing
      </a>
      <h1 class="mb-4 text-3xl font-normal leading-tight tracking-tight text-primary md:text-4xl">
        {title}
      </h1>
      <div class="flex flex-wrap items-center gap-3 font-sans text-[13px] text-dim">
        <span class="flex items-center gap-1">
          <i class="ph ph-calendar-blank text-xs" aria-hidden="true" />
          {formattedDate}
        </span>
        {tags.map((tag) => (
          <span class="rounded bg-accent-subtle px-2.5 py-0.5 font-medium text-accent-bright">
            {tag}
          </span>
        ))}
      </div>
    </header>
    <Prose>
      <slot />
    </Prose>
  </article>
</BaseLayout>
