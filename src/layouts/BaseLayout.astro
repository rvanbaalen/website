---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import { normalizePath } from "../lib/seo";
import TopoPattern from "../components/TopoPattern.astro";
import Sidebar from "../components/Sidebar.astro";
import MobileNav from "../components/MobileNav.astro";
import ThemeSwitch from "../components/ThemeSwitch.astro";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  type?: "website" | "article";
  publishedTime?: Date;
  tags?: string[];
  jsonLd?: object | object[];
}

const {
  title,
  description = "Robin van Baalen — Founder and software engineer. I build products, ship open source, and advise teams on software architecture.",
  ogImage = new URL("/og/default.png", Astro.site).href,
  type = "website",
  publishedTime,
  tags = [],
  jsonLd,
} = Astro.props;

const currentPath = normalizePath(Astro.url.pathname);
const canonicalURL = new URL(currentPath, Astro.site);
const jsonLdBlocks = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang="en" class="scroll-smooth" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="author" content="Robin van Baalen" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0d0d12" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f7f6f3" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Robin van Baalen" />
    <meta property="og:locale" content="en_US" />
    {type === "article" && publishedTime && (
      <meta property="article:published_time" content={publishedTime.toISOString()} />
    )}
    {type === "article" && tags.map((tag) => <meta property="article:tag" content={tag} />)}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {jsonLdBlocks.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}

    <script async src="https://www.googletagmanager.com/gtag/js?id=G-DY4RKECQCF"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag("js", new Date());
      gtag("config", "G-DY4RKECQCF", { send_page_view: false, language: document.documentElement.lang || "en" });
      document.addEventListener("astro:page-load", function () {
        gtag("event", "page_view", {
          page_location: location.href,
          page_title: document.title,
        });
      });
    </script>

    <link rel="alternate" type="application/rss+xml" title="Robin van Baalen" href="/rss.xml" />
    <script is:inline>
      (function() {
        function applyPrefs() {
          var pref = localStorage.getItem('theme-pref') || 'auto';
          var theme = pref === 'auto'
            ? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
            : pref;
          document.documentElement.setAttribute('data-theme', theme);
          document.documentElement.classList.add('js');
        }
        applyPrefs();
        document.addEventListener('astro:after-swap', applyPrefs);
      })();
    </script>
    <ClientRouter />
  </head>
  <body class="overflow-x-hidden bg-canvas text-secondary font-serif text-base transition-colors duration-300 ease-move">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:rounded-md focus:border focus:border-edge focus:bg-surface focus:px-4 focus:py-2 focus:font-sans focus:text-xs focus:text-primary"
    >
      Skip to content
    </a>
    <TopoPattern />
    <div class="relative z-10 mx-auto grid min-h-screen md:grid-cols-[260px_1fr]">
      <Sidebar currentPath={currentPath} />
      <main id="main" class="min-w-0 max-w-[820px] px-6 py-12 md:px-16 md:py-12">
        <slot />
      </main>
    </div>
    <footer class="relative z-10 mx-6 mt-4 border-t border-edge-subtle pb-24 pt-6 font-sans md:hidden">
      <div class="mx-auto mb-5 max-w-[220px]">
        <ThemeSwitch />
      </div>
      <div class="mb-3 flex justify-center gap-5">
        <a href="https://github.com/rvanbaalen" target="_blank" rel="noopener noreferrer" class="text-dim text-[18px] transition-colors duration-150 hover:text-accent-bright" aria-label="GitHub">
          <i class="ph ph-github-logo" />
        </a>
        <a href="https://www.linkedin.com/in/robinvanbaalen/" target="_blank" rel="noopener noreferrer" class="text-dim text-[18px] transition-colors duration-150 hover:text-accent-bright" aria-label="LinkedIn">
          <i class="ph ph-linkedin-logo" />
        </a>
      </div>
      <p class="text-center text-2xs text-dim">&copy; 2026 Robin van Baalen</p>
    </footer>
    <MobileNav currentPath={currentPath} />

    <script>
      // One delegated clipboard handler for every [data-copy-cmd] button on the site.
      // Module scripts persist across view transitions, so no re-init is needed.
      document.addEventListener("click", async (e) => {
        const btn = (e.target as Element).closest?.("[data-copy-cmd]") as HTMLElement | null;
        if (!btn) return;
        e.preventDefault();
        e.stopPropagation();
        const cmd = btn.getAttribute("data-copy-cmd");
        if (!cmd) return;
        const label = btn.querySelector(".copy-label");
        const icon = btn.querySelector(".copy-icon");
        const idle = btn.getAttribute("data-copy-idle") || "Copy";
        try {
          await navigator.clipboard.writeText(cmd);
          if (label) label.textContent = "Copied!";
          icon?.classList.replace("ph-copy", "ph-check");
        } catch {
          if (label) label.textContent = cmd;
        }
        setTimeout(() => {
          if (label) label.textContent = idle;
          icon?.classList.replace("ph-check", "ph-copy");
        }, 2000);
      });
    </script>
  </body>
</html>
