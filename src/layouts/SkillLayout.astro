---
import BaseLayout from "./BaseLayout.astro";
import Prose from "../components/Prose.astro";
import { softwareSourceCodeSchema, breadcrumbSchema, normalizePath } from "../lib/seo";

interface Props {
  frontmatter: {
    name: string;
    description: string;
    version: string;
    author: string;
    invoke?: string;
    install: string;
    repo: string;
    category?: "skill" | "agent";
  };
}

const { name, description, version, author, invoke, install, repo, category = "skill" } = Astro.props.frontmatter;
const installCmd = `/plugin install ${install}`;
const categoryLabel = category === "agent" ? "Agent Plugin" : "Skill";

const pagePath = normalizePath(Astro.url.pathname);
const pageUrl = new URL(pagePath, Astro.site).href;
const jsonLd = [
  softwareSourceCodeSchema({ name, description, repo, version, url: pageUrl }),
  breadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "Agent Skills", path: "/skills" },
    { name, path: pagePath },
  ]),
];
---

<BaseLayout title={`${name} — Agent Skills — Robin van Baalen`} description={description} jsonLd={jsonLd}>
  <article>
    <header class="mb-10">
      <a
        href="/skills"
        class="mb-6 inline-flex items-center gap-1.5 font-sans text-xs text-muted transition-colors duration-150 hover:text-accent"
      >
        <i class="ph ph-arrow-left text-[13px]" aria-hidden="true" />
        All skills
      </a>
      <h1 class="mb-3 text-xl font-normal text-primary">
        {name}
      </h1>
      <p class="mb-4 text-base text-muted">{description}</p>
      <div class="flex flex-wrap items-center gap-3 font-sans text-xs text-dim">
        <span class="rounded bg-accent-subtle px-2.5 py-0.5 font-medium text-accent-bright">
          v{version}
        </span>
        <span class="rounded bg-surface px-2.5 py-0.5 text-muted">
          {categoryLabel}
        </span>
        <span class="flex items-center gap-1">
          <i class="ph ph-user text-[13px]" aria-hidden="true" />
          {author}
        </span>
        {invoke && (
          <code class="rounded bg-surface px-2.5 py-0.5 font-mono text-2xs text-muted">
            {invoke}
          </code>
        )}
        <a
          href={`https://github.com/${repo}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 text-accent transition-colors duration-150 hover:text-accent-bright"
        >
          <i class="ph ph-github-logo text-sm" aria-hidden="true" />
          Source
        </a>
      </div>

      <div class="mt-6 flex items-center gap-2 overflow-hidden rounded-md border border-edge bg-[var(--color-canvas)] px-4 py-3">
        <code class="min-w-0 flex-1 overflow-x-auto font-mono text-sm text-secondary">{installCmd}</code>
        <button
          type="button"
          class="flex shrink-0 cursor-pointer items-center gap-1.5 rounded-md border border-edge bg-surface px-3 py-1.5 font-sans text-xs text-muted transition-[background,border-color,color] duration-150 hover:border-accent-dim hover:text-accent-bright"
          data-copy-cmd={installCmd}
          data-copy-idle="Copy"
          aria-label="Copy install command"
        >
          <i class="ph ph-copy text-[14px] copy-icon" aria-hidden="true" />
          <span class="copy-label" aria-live="polite">Copy</span>
        </button>
      </div>
    </header>
    <Prose>
      <slot />
    </Prose>
  </article>
</BaseLayout>
