---
import { Image } from "astro:assets";
import NavItem from "./NavItem.astro";
import ThemeSwitch from "./ThemeSwitch.astro";
import avatarImg from "../assets/avatar.png";

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const navItems = [
  { href: "/", icon: "house", label: "Home" },
  { href: "/open-source", icon: "git-branch", label: "Open Source", transitionName: "nav-opensource" },
  { href: "/skills", icon: "lightning", label: "Agent Skills", transitionName: "nav-skills" },
  { href: "/writing", icon: "notebook", label: "Writing", transitionName: "nav-writing" },
  { href: "/about", icon: "user-circle", label: "About" },
  { href: "/contact", icon: "envelope-simple", label: "Contact", transitionName: "nav-contact" },
];

function isActive(href: string, current: string): boolean {
  if (href === "/") return current === "/";
  return current.startsWith(href);
}
---

<div class="sticky top-0 h-screen p-4 pr-0 hidden md:block" transition:name="sidebar" transition:animate="none">
  <aside class="flex h-full flex-col rounded-lg border border-edge bg-surface/70 backdrop-blur-[16px] p-8 pb-6 transition-colors duration-300 ease-move">
    <div class="avatar-grayscale relative">
      <Image
        src={avatarImg}
        alt="Robin van Baalen"
        class="mb-3.5 h-40 w-40 rounded-full border-2 border-edge"
        width={160}
        height={160}
        loading="eager"
      />
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" class="absolute left-1 bottom-3 h-14 w-14 rotate-[50deg] text-accent-dim" aria-hidden="true">
        <polyline points="152 80 104 32 56 80" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="16"/>
        <path d="M200,224a96,96,0,0,1-96-96V32" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="16"/>
      </svg>
    </div>
    <p class="mb-0.5 text-sm font-semibold text-primary">That's me.</p>
    <p class="mb-7 font-sans text-xs leading-snug text-muted">
      <span class="font-medium text-secondary">Founder and software engineer.</span> This is my passion, not just my job.
    </p>
    <nav class="relative flex flex-1 flex-col gap-0.5" aria-label="Main navigation" data-sidebar-nav>
      <span
        class="absolute left-0 z-10 h-1 w-1 rounded-full bg-accent-bright animate-[pulse-dot_2s_ease-in-out_infinite] transition-[top] duration-300 ease-out"
        data-nav-dot
        aria-hidden="true"
      />
      {navItems.map((item) => (
        <NavItem
          href={item.href}
          icon={item.icon}
          label={item.label}
          active={isActive(item.href, currentPath)}
          transitionName={item.transitionName}
        />
      ))}
    </nav>

    <script>
      function updateActiveNav() {
        const path = window.location.pathname.replace(/\.html$/, "");
        const items = document.querySelectorAll("[data-nav-item]");
        items.forEach((item) => {
          const href = item.getAttribute("href") || "";
          const isActive = href === "/" ? path === "/" : path.startsWith(href);
          if (isActive) {
            item.setAttribute("data-active", "true");
            item.setAttribute("aria-current", "page");
            item.classList.remove("text-muted", "hover:text-primary");
            item.classList.add("text-accent-bright", "active");
          } else {
            item.removeAttribute("data-active");
            item.removeAttribute("aria-current");
            item.classList.remove("text-accent-bright", "active");
            item.classList.add("text-muted", "hover:text-primary");
          }
        });
      }

      function moveDotTo(item: Element) {
        const nav = document.querySelector("[data-sidebar-nav]");
        const dot = document.querySelector<HTMLElement>("[data-nav-dot]");
        if (!nav || !dot) return;
        const navRect = nav.getBoundingClientRect();
        const itemRect = item.getBoundingClientRect();
        dot.style.top = `${itemRect.top - navRect.top + itemRect.height / 2 - 2}px`;
      }

      function positionNavDot() {
        updateActiveNav();
        const dot = document.querySelector<HTMLElement>("[data-nav-dot]");
        const active = document.querySelector("[data-nav-item][data-active]");
        if (!dot) return;
        if (!active) {
          dot.style.opacity = "0";
          return;
        }
        moveDotTo(active);
        dot.style.opacity = "1";
      }

      positionNavDot();
      document.addEventListener("astro:page-load", positionNavDot);

      // Delegated so listeners survive view-transition DOM swaps:
      // dot tracks the hovered nav item, returns to active on leave
      document.addEventListener("mouseover", (e) => {
        const item = (e.target as Element).closest?.("[data-nav-item]");
        if (item) moveDotTo(item);
      });
      document.addEventListener("mouseout", (e) => {
        const withinNav = (e.target as Element).closest?.("[data-sidebar-nav]");
        const stillWithin = (e.relatedTarget as Element | null)?.closest?.("[data-sidebar-nav]");
        if (withinNav && !stillWithin) positionNavDot();
      });
    </script>
    <div class="mt-auto border-t border-edge pt-4">
      <div class="mb-3">
        <ThemeSwitch />
      </div>
      <div class="mb-2.5 flex gap-3.5">
        <a href="https://github.com/rvanbaalen" target="_blank" rel="noopener noreferrer" class="text-dim text-[18px] transition-colors duration-150 hover:text-accent-bright" aria-label="GitHub">
          <i class="ph ph-github-logo" />
        </a>
        <a href="https://www.linkedin.com/in/robinvanbaalen/" target="_blank" rel="noopener noreferrer" class="text-dim text-[18px] transition-colors duration-150 hover:text-accent-bright" aria-label="LinkedIn">
          <i class="ph ph-linkedin-logo" />
        </a>
      </div>
      <p class="font-sans text-2xs text-dim">&copy; 2026 Robin van Baalen</p>
    </div>
  </aside>
</div>
