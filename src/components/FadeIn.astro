---
interface Props {
  delay?: number;
  class?: string;
}

const { delay = 0, class: className = "" } = Astro.props;
---

{/* Hidden state is gated on the .js root class so content stays visible without JavaScript */}
<div
  class:list={[
    "fade-in-target transition-[opacity,transform] duration-500 ease-enter [.js_&]:opacity-0 [.js_&]:translate-y-4",
    className,
  ]}
  style={delay ? `transition-delay: ${delay}ms` : undefined}
>
  <slot />
</div>

<script>
  function initFadeIn() {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.remove("[.js_&]:opacity-0", "[.js_&]:translate-y-4");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15 },
    );

    document.querySelectorAll(".fade-in-target:not([data-fade-observed])").forEach((el) => {
      el.setAttribute("data-fade-observed", "");
      observer.observe(el);
    });
  }
  document.addEventListener("astro:page-load", initFadeIn);
</script>
